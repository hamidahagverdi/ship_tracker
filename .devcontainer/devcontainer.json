{
  "name": "ship-tracker",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [9001, 8080, 8081, 5432],
  "portsAttributes": {
    "9001": { "label": "MinIO Console" },
    "8080": { "label": "Spark UI" },
    "8081": { "label": "Airflow" }
  },
  "postCreateCommand": "pip install kafka-python websockets requests pyspark"
}
